{
  "name": "tui-map",
  "version": "0.1.0",
  "scripts": {
    "build": "cargo build --release",
    "dev": "cargo run",
    "start": "cargo run --release",
    "test": "cargo test",
    "clean": "cargo clean",
    "build:web": "wasm-pack build --target web --out-dir web/pkg --release && node web/build.mjs",
    "dev:web": "node web/serve.mjs",
    "test:web": "node --test web/smoke.test.mjs web/feeds.test.mjs"
  }
}
